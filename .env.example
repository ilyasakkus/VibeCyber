# `npm run dev:full` bu değerleri güvenli yerel varsayılanlarla kendisi üretir.
# Ayrı süreçler çalıştırırken aşağıdaki değişkenleri kullanabilirsiniz.
WEBCYBER_API_URL=http://127.0.0.1:7071
WEBCYBER_CONTROL_ADDR=127.0.0.1:7071
WEBCYBER_CONTROL_TOKEN=replace-with-at-least-32-random-bytes
WEBCYBER_ALLOW_LOCAL=false
WEBCYBER_MAX_CONCURRENCY=2
WEBCYBER_MAX_JOBS=100
WEBCYBER_MAX_RETAINED=100
