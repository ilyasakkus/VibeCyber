{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webcyber.dev/schemas/plugin-manifest.schema.json",
  "title": "WebCyber Scanner Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "version",
    "image",
    "targets",
    "network",
    "limits",
    "output"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,62}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "image": {
      "type": "string",
      "pattern": "^[^@\\s]+@sha256:[a-f0-9]{64}$"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["web", "source", "mobile", "desktop"] }
    },
    "network": { "enum": ["none", "target-only"] },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": { "enum": ["none", "read-only"] },
        "scratchMiB": { "type": "integer", "minimum": 0, "maximum": 4096 }
      },
      "required": ["artifact", "scratchMiB"]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutSeconds", "cpuMillis", "memoryMiB", "pids", "outputMiB"],
      "properties": {
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "cpuMillis": { "type": "integer", "minimum": 50, "maximum": 8000 },
        "memoryMiB": { "type": "integer", "minimum": 32, "maximum": 8192 },
        "pids": { "type": "integer", "minimum": 1, "maximum": 512 },
        "outputMiB": { "type": "integer", "minimum": 1, "maximum": 256 }
      }
    },
    "configSchema": { "type": "object" },
    "output": { "enum": ["webcyber-jsonl-v1", "sarif-2.1.0"] },
    "rulePack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
